# Titan OS — required environment variables
# Copy to .env (local) or configure in Vercel dashboard.
# Never commit actual values to source control.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Your project's API URL (not secret — safe in browser bundles)
SUPABASE_URL=https://your-project.supabase.co

# Service role key — bypasses RLS, full DB access.
# Server-side only. Never expose to browsers or log.
SUPABASE_SERVICE_KEY=

# ── Admin authentication ──────────────────────────────────────────────────────
# Password used to log in to the /admin dashboard.
# Never include in source code, documentation, or chat.
ADMIN_PASSWORD=

# Secret used to sign admin session tokens (HMAC-SHA256).
# Must be a long random string. Never fall back to SUPABASE_SERVICE_KEY.
# Generate: openssl rand -hex 32
ADMIN_TOKEN_SECRET=

# Set to "true" to activate real data routes in the admin panel.
# When false (or unset), admin shows synthetic demo data only.
# Server-side only — browser cannot override this.
ADMIN_PRODUCTION_MODE=false

# ── Upstash Redis (rate limiting) ─────────────────────────────────────────────
# REST URL from your Upstash Redis database dashboard.
UPSTASH_REDIS_REST_URL=

# REST token from your Upstash Redis database dashboard.
UPSTASH_REDIS_REST_TOKEN=

# ── Per-endpoint rate limits (optional — defaults shown) ─────────────────────
# Format: "max_requests:window_seconds"
# RATE_LIMIT_MEASURE=10:60
# RATE_LIMIT_CONTACT=5:600
# RATE_LIMIT_ADMIN_AUTH=5:900
# RATE_LIMIT_MEASURE_LIDAR=10:60

# ── External APIs ────────────────────────────────────────────────────────────
# Regrid parcel data API key (encrypted Vercel env var — never paste in chat)
REGRID_API_KEY=

# Resend transactional email API key
RESEND_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins for Python endpoints.
# Defaults to the Vercel deployment URL if unset.
# CORS_ALLOWED_ORIGINS=https://titan-roofing.vercel.app,https://yourdomain.com

# Set by Vercel automatically — used by rate limiter to distinguish prod vs dev.
# Do not set manually.
# VERCEL_ENV=production
